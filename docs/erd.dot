digraph ERD {
  rankdir=LR; fontname="Helvetica"; node [shape=plain, fontname="Helvetica", fontsize=10]; edge [arrowhead=crow, arrowtail=none, dir=both, color="#5b6b7b"];
  allocation [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>allocation</b></td></tr><tr><td align="left">PK stream, slot</td></tr><tr><td align="left">block_no</td></tr><tr><td align="left">condition (0/1)</td></tr><tr><td align="left">used_by → study_code</td></tr></table>>];
  participants [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>participants</b></td></tr><tr><td align="left">PK study_code</td></tr><tr><td align="left">condition (0/1)</td></tr><tr><td align="left">alloc_slot</td></tr><tr><td align="left">is_test</td></tr><tr><td align="left">profile_order</td></tr><tr><td align="left">status, created_at, completed_at</td></tr></table>>];
  consent [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#f2e6d9"><b>consent_records</b> (separate)</td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">study_code</td></tr><tr><td align="left">consented, is_student,</td></tr><tr><td align="left">age_18_25, dating_app</td></tr></table>>];
  profiles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>profiles</b></td></tr><tr><td align="left">PK profile_id</td></tr><tr><td align="left">display_name, age, bio</td></tr><tr><td align="left">image_file</td></tr><tr><td align="left">image_sha256</td></tr></table>>];
  ratings [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>ratings</b></td></tr><tr><td align="left">PK/FK study_code</td></tr><tr><td align="left">PK/FK profile_id</td></tr><tr><td align="left">PK item_no</td></tr><tr><td align="left">position, construct</td></tr><tr><td align="left">value (1-7), decision</td></tr></table>>];
  events [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>events</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK study_code</td></tr><tr><td align="left">profile_id</td></tr><tr><td align="left">event_type, value_ms</td></tr></table>>];
  post [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#dde5ee"><b>post_survey</b></td></tr><tr><td align="left">PK/FK study_code</td></tr><tr><td align="left">label_recall</td></tr><tr><td align="left">open_text</td></tr><tr><td align="left">gender, study_year, app_use_freq</td></tr></table>>];
  participants -> ratings; profiles -> ratings; participants -> events; participants -> post [arrowhead=tee];
  allocation -> participants [arrowhead=tee, label=" 1:1"]; participants -> consent [arrowhead=tee, style=dashed];
}
